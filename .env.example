# Copy to .env only if it does not exist. Never commit real credentials.
# Use development accounts. All keys below are server-side, not NEXT_PUBLIC_*.

# Agent models use OpenRouter.
OPENROUTER_API_KEY=replace-with-development-openrouter-key

# Database URL is currently fixed in src/mastra/index.ts.
# Confirm it targets a development database before supplying a real token.
LIBSQL_AUTH_TOKEN=replace-with-development-libsql-token

# Keep these non-empty to avoid hard-coded credential fallbacks.
GOOGLE_PLACES_API_KEY=replace-with-restricted-development-google-key
SERPAPI_API_KEY=replace-with-development-serpapi-key

# Required for live social-media scraping.
SCRAPE_CREATORS_API_KEY=replace-with-development-scrape-creators-key

# true mocks reviews, web search, and social scraping only.
# It does not disable model, database, or Google Places requests.
MOCK_TOOLS=false
